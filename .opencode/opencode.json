{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "compaction": {
    "auto": true,
    "threshold": 0.65
  },
  "provider": {
    "options": {
      "timeout": 300000,
      // Force stream death after 10s of zero chunks received
      "chunkTimeout": 10000,
      // Enable TCP keep-alive checks
      "keepAlive": true,
      "keepAliveMsecs": 5000
    }
  },
  "plugin": [
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz",
    "./plugins/xml-guard.js",
    "./plugins/network-watchdog.js"
  ],
  "permission": {
    "todowrite": "allow",
    "skill": {
      "*": "allow"
    },
    "read": {
      "*": "allow",
      "data": "allow",
      "data/**": "allow",
      "/tmp": "deny",
      "/tmp/**": "deny",
      "/var/tmp": "deny",
      "/var/tmp/**": "deny"
    },
    "edit": {
      "*": "allow",
      "data": "deny",
      "data/**": "deny",
      "/tmp": "deny",
      "/tmp/**": "deny",
      "/var/tmp": "deny",
      "/var/tmp/**": "deny"
    },
    "bash": {
      "*": "allow",
      "*data*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "* /tmp*": "deny",
      "* /var/tmp*": "deny"
    }
  }
}
