{
    // Uses tomblind.local-lua-debugger-vscode ("lua-local").
    // The extension puts its debugger on LUA_PATH and sets LOCAL_LUA_DEBUGGER_VSCODE=1;
    // src/main.lua calls require('lldebugger').start() when the `debug` arg is present.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Run Game",
            "cwd": "${workspaceFolder}",
            "scriptRoots": ["${workspaceFolder}"],
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}"
            ]
        },
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Run Game (pick map)",
            "cwd": "${workspaceFolder}",
            "scriptRoots": ["${workspaceFolder}"],
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}",
                "map=${input:map}"
            ]
        },
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Debug",
            "cwd": "${workspaceFolder}",
            "scriptRoots": ["${workspaceFolder}"],
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}",
                "debug"
            ]
        },
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Debug (pick map)",
            "cwd": "${workspaceFolder}",
            "scriptRoots": ["${workspaceFolder}"],
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}",
                "debug",
                "drawphysics",
                "map=${input:map}"
            ]
        },
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Debug (map=sandbox.lua)",
            "cwd": "${workspaceFolder}",
            "scriptRoots": ["${workspaceFolder}"],
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}",
                "debug",
                "drawphysics",
                "map=sandbox.lua"
            ]
        },
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Profile",
            "cwd": "${workspaceFolder}",
            "scriptRoots": ["${workspaceFolder}"],
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}",
                "profile"
            ]
        }
    ],
    "inputs": [
        {
            "id": "map",
            "type": "pickString",
            "description": "Map to load from res/map/",
            "default": "sandbox.lua",
            "options": [
                "sandbox.lua",
                "ll1.lua",
                "ll2.lua",
                "drawbridge_fixture.lua"
            ]
        }
    ]
}
